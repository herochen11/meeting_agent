# === Vexa 0.10.6 Configuration ===
# 複製此檔案為 .env 並填入實際值

# --- Vexa Transcription Service ---
TRANSCRIPTION_SERVICE_URL=https://transcription.vexa.ai/v1/audio/transcriptions
TRANSCRIPTION_SERVICE_TOKEN=<your-vexa-transcription-token>

# --- Admin ---
ADMIN_TOKEN=<your-admin-token>
DOCKER_GID=1001

# --- Docker Images ---
IMAGE_TAG=0.10.6-260506-0424
BROWSER_IMAGE=vexaai/vexa-bot:0.10.6-260506-0424

# --- Ports ---
API_GATEWAY_HOST_PORT=8056
ADMIN_API_PORT=8057
RUNTIME_API_PORT=8090
POSTGRES_HOST_PORT=5458
MCP_HOST_PORT=18888
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Database ---
DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=postgres

# --- Storage ---
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=vexa-access-key
MINIO_SECRET_KEY=vexa-secret-key
MINIO_BUCKET=vexa
MINIO_SECURE=false

# --- Post Meeting Hook ---
POST_MEETING_HOOKS=http://host.docker.internal:8901/hooks/meeting-completed

# --- Vexa API Key (make all-build 會自動產生 VEXA_API_KEY，或手動填入) ---
# VEXA_USER_API_KEY=<your-vexa-api-key>

# --- Telegram Bot ---
BOT_TOKEN=<your-telegram-bot-token>

# --- Google (可選，server.py 會自動從 .env 讀取) ---
# GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
# SHARE_WITH_EMAIL=your-email@gmail.com
