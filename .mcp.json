{
  "mcpServers": {
    "vexa-webhook": {
      "command": "bun",
      "args": [
        "./mcp/webhook-channel.ts"
      ],
      "env": {
        "WEBHOOK_PORT": "8901"
      }
    },
    "vexa": {
      "type": "stdio",
      "command": "python",
      "args": [
        "./mcp/server.py"
      ],
      "env": {}
    }
  }
}