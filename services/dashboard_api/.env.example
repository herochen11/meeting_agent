# dashboard_api server bind config.
#
# 兩種模式（用 Makefile `make local` / `make lan` 切換）：
#   HOST=127.0.0.1   → local only（預設，安全）
#   HOST=0.0.0.0     → LAN bind（同網段裝置可連，會議 demo 用）
HOST=127.0.0.1
PORT=8765
DATABASE_URL=postgres://postgres:postgres@localhost:5458/vexa
SESSION_SECRET=change-me-to-a-random-string
RECORDS_DIR=/home/user/Agents/meeting_agent/records
VEXA_API_BASE=http://localhost:8056
VEXA_USER_API_KEY=change-me-to-vexa-user-api-key
MEETING_MAP_PATH=/home/user/Agents/meeting_agent/config/meeting_map.json

# Telegram Bot Token（用於派 bot 後送 recap 訊息、處理中提示、會議結束通知）
# 從 BotFather 申請新的 bot，把它加入所有部門群組
BOT_TOKEN=change-me-to-telegram-bot-token

# Google Calendar OAuth（月曆 Tab + 自動加入會議功能用）
#
# 設定步驟：
# 1. 進 https://console.cloud.google.com/，建立新專案（或用既有專案）
# 2. APIs & Services → Library → 搜「Google Calendar API」→ Enable
# 3. APIs & Services → OAuth consent screen：
#    - User Type: External（gmail 也能用）或 Internal（限 Workspace 網域內）
#    - 填 App name / User support email / Developer contact information
#    - Scopes 加：calendar.readonly + calendar.events.readonly
#    - Test users 加上要連結的 Google email（Testing 模式最多 100 人）
# 4. APIs & Services → Credentials → Create credentials → OAuth client ID：
#    - Application type: Web application
#    - Authorized redirect URIs: http://localhost:8765/api/calendar/oauth-callback
#    - 拿到 client_id + client_secret 填到下面
#
# ⚠️ Testing 模式 refresh token 7 天過期；In production 但未驗證上限 100 users。
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me-to-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/api/calendar/oauth-callback
