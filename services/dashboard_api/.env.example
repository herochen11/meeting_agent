# dashboard_api server bind config.
#
# 兩種模式（用 Makefile `make local` / `make lan` 切換）：
#   HOST=127.0.0.1   → local only（預設，安全）
#   HOST=0.0.0.0     → LAN bind（同網段裝置可連，會議 demo 用）
HOST=127.0.0.1
PORT=8765
DATABASE_URL=postgres://postgres:postgres@localhost:5458/vexa
SESSION_SECRET=change-me-to-a-random-string
RECORDS_DIR=/home/user/Agents/meeting_agent/records
VEXA_API_BASE=http://localhost:8056
VEXA_USER_API_KEY=change-me-to-vexa-user-api-key
MEETING_MAP_PATH=/home/user/Agents/meeting_agent/config/meeting_map.json
