# 連 dashboard 共用的 PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5458/vexa

# 通知目標：webhook-channel HTTP 入口
WEBHOOK_URL=http://localhost:8901

# 多久 poll 一次（毫秒，預設 60000=1 分鐘）
POLL_INTERVAL_MS=60000

# Google OAuth Client（refresh token 換新 access token 用）
# 跟 dashboard_api 共用同一組
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
